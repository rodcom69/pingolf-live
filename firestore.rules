rules_version = '2';

// Pingolf Live. Paste into Firebase console > Firestore Database > Rules > Publish.
// There are no logins. What these rules do:
//  - each player signs up once with name + a 4-digit PIN. The PIN is kept in
//    playerSecrets/{name}, which no client can read. Every score a player saves
//    carries a one-time playerUnlock doc with that PIN, so a player can only
//    add or change scores under their own name.
//  - events live in events/{id}; players add scores only to an event whose status is 'open',
//    and never to a hole the organizer closed (events/{id}.closedHoles = closed for now,
//    events/{id}.removedHoles = removed for good)
//  - a player can fix or undo an entry for 2 minutes after saving it; then it's locked
//  - a new score may arrive up to 30 minutes after it was entered (phone was offline,
//    the save was queued) or up to 5 minutes "early" (phone clock running fast)
//  - the organizer page (admin.html) can change anything, but every change must come
//    with a one-time unlock doc carrying the admin PIN. The PIN lives in secrets/admin,
//    which no client can read; the rules compare it here.
//  - every score must have a sane shape (hole 1-60, strokes 1-9 (9 = objective hole not done), short name)
//  - events can only be created or changed by the organizer page
//  - playerContacts/{name}: optional email, write-only for players, readable only by the organizer's Google sign-in
//  - location admins (admin.html?loc=<id>): each location has its own PIN in secrets/loc_<id> (set by the organizer,
//    never readable). A change carries a one-time locUnlock doc {loc, pin}. With it, a location can create events for
//    itself (events/{id}.loc = its id), and on its own events change everything except loc/course/test, and add, fix
//    or void scores. It can never touch another location's events or scores, players, PINs or secrets/admin.
//  - everything else is closed
service cloud.firestore {
  match /databases/{database}/documents {

    function eventOpen(eventId) {
      return get(db('events/' + eventId)).data.status == 'open';
    }
    // Open for scores, and this hole hasn't been closed (machine down).
    function eventAccepts(d) {
      let ev = get(db('events/' + d.eventId)).data;
      return ev.status == 'open'
        && (!('closedHoles' in ev) || !(d.hole in ev.closedHoles))
        && (!('removedHoles' in ev) || !(d.hole in ev.removedHoles))
        && (!('closesAt' in ev) || request.time.toMillis() < ev.closesAt);
    }
    function nowMs() {
      return request.time.toMillis();
    }

    function hasValidShape(d) {
      return d.keys().hasOnly(['playerKey', 'playerName', 'hole', 'holeName', 'target',
                               'strokes', 'method', 'eventId', 'eventLabel', 'ts',
                               'ball', 'rawScore', 'mulligan', 'void', 'unlockId', 'editedByAdmin', 'proof', 'card'])
        && validName(d.playerName)
        && d.playerKey is string && d.playerKey.size() > 0 && d.playerKey.size() <= 40
        && d.hole is int && d.hole >= 1 && d.hole <= 60
        && d.strokes is int && d.strokes >= 1 && d.strokes <= 9
        && d.method in ['ball', 'chart']
        && d.ts is int
        && (!('mulligan' in d) || d.mulligan == true)
        && (!('void' in d) || d.void is bool)
        && (!('card' in d) || (d.card is int && d.card >= 1 && d.card <= 50))
        && d.eventId is string;
    }

    function db(p) {
      return path('/databases/' + database + '/documents/' + p);
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 40 && n.matches('^\\S(.*\\S)?$');
    }
    function validPin(n) {
      return n is string && n.matches('^[0-9]{4}$');
    }
    // The same request created playerUnlock/{id} for this player (with the right PIN).
    function playerProved(unlockId, key) {
      return getAfter(db('playerUnlock/' + unlockId)).data.playerKey == key
        && getAfter(db('playerUnlock/' + unlockId)).data.at == request.time;
    }
    // The same request created adminUnlock/{id} with the right PIN.
    function adminProved(d) {
      return d.unlockId is string
        && getAfter(db('adminUnlock/' + d.unlockId)).data.at == request.time;
    }

    // The same request created locUnlock/{id} for location `loc` (with that location's PIN).
    function locProved(unlockId, loc) {
      return unlockId is string && loc is string && loc != ''
        && getAfter(db('locUnlock/' + unlockId)).data.at == request.time
        && getAfter(db('locUnlock/' + unlockId)).data.loc == loc;
    }
    // A location write to a score: the score's event belongs to the location that signed this change.
    function isLocWrite(d) {
      return hasValidShape(d) && 'unlockId' in d
        && locProved(d.unlockId, get(db('events/' + d.eventId)).data.get('loc', ''));
    }

    // A player write: current event, no organizer-only fields, signed with their PIN.
    function isPlayerWrite(d) {
      return hasValidShape(d)
        && !('void' in d) && !('unlockId' in d) && !('editedByAdmin' in d)
        && eventAccepts(d)
        && d.proof is string && playerProved(d.proof, d.playerKey);
    }

    // An organizer write: the same batch created adminUnlock/{unlockId} with the right PIN.
    function isAdminWrite(d) {
      return hasValidShape(d) && adminProved(d);
    }

    function inEditWindow(d) {
      return nowMs() - d.ts < 120000;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    function eventShape(d) {
      return d.keys().hasOnly(['name', 'location', 'date', 'time', 'course', 'status', 'test', 'closedHoles', 'removedHoles', 'closesAt', 'rankFinishedFirst', 'note', 'multiCard', 'hiddenPlayers', 'unlockId', 'loc'])
                    && (!('loc' in d) || (d.loc is string && d.loc.size() <= 30))
                    && (!('closedHoles' in d) || (d.closedHoles is list && d.closedHoles.size() <= 30))
                    && (!('hiddenPlayers' in d) || (d.hiddenPlayers is list && d.hiddenPlayers.size() <= 100))
                    && (!('removedHoles' in d) || (d.removedHoles is list && d.removedHoles.size() <= 30))
                    && (!('closesAt' in d) || d.closesAt is int)
                    && (!('rankFinishedFirst' in d) || d.rankFinishedFirst is bool)
                    && (!('multiCard' in d) || d.multiCard is bool)
                    && (!('note' in d) || (d.note is string && d.note.size() <= 300))
                    && d.name is string && d.name.size() > 0 && d.name.size() <= 60
                    && d.location is string && d.location.size() <= 80
                    && d.date is string && d.time is string
                    && d.course is string
                    && d.status in ['upcoming', 'open', 'closed']
                    && d.test is bool;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if eventShape(request.resource.data)
                    && adminProved(request.resource.data);
      // A location admin: create an event for itself, or change its own (never loc, course or test).
      allow create: if eventShape(request.resource.data)
                    && locProved(request.resource.data.get('unlockId', ''), request.resource.data.get('loc', ''));
      allow update: if eventShape(request.resource.data)
                    && locProved(request.resource.data.get('unlockId', ''), resource.data.get('loc', ''))
                    && request.resource.data.get('loc', '') == resource.data.get('loc', '')
                    && request.resource.data.course == resource.data.course
                    && request.resource.data.test == resource.data.test;
      allow delete: if false;
    }

    match /attempts/{attemptId} {
      allow read: if true;
      allow create: if (isPlayerWrite(request.resource.data)
                        && request.resource.data.ts > nowMs() - 1800000
                        && request.resource.data.ts < nowMs() + 300000)
                    || isAdminWrite(request.resource.data)
                    || isLocWrite(request.resource.data);
      allow update: if (isPlayerWrite(request.resource.data)
                        && resource.data.eventId == request.resource.data.eventId
                        && resource.data.playerKey == request.resource.data.playerKey
                        && resource.data.get('card', 1) == request.resource.data.get('card', 1)
                        && !('editedByAdmin' in resource.data)
                        && request.resource.data.ts == resource.data.ts
                        && inEditWindow(resource.data))
                    || isAdminWrite(request.resource.data)
                    // A location admin fixing/voiding a score on its own event (same event, player, card, hole).
                    || (isLocWrite(request.resource.data)
                        && resource.data.eventId == request.resource.data.eventId
                        && resource.data.playerKey == request.resource.data.playerKey
                        && resource.data.get('card', 1) == request.resource.data.get('card', 1)
                        && resource.data.hole == request.resource.data.hole);
      // Undo: the same request creates playerUnlock/del_{attemptId} for the owner.
      allow delete: if eventOpen(resource.data.eventId)
                    && !('editedByAdmin' in resource.data)
                    && inEditWindow(resource.data)
                    && playerProved('del_' + attemptId, resource.data.playerKey);
    }

    // Registered players (names only; anyone can see who has signed up).
    // Sign-up writes players/{key} and playerSecrets/{key} in one batch.
    match /players/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'at'])
                    && validName(request.resource.data.name)
                    && request.resource.data.name.lower() == key
                    && request.resource.data.at == request.time
                    && existsAfter(db('playerSecrets/' + key));
      // organizer: register a player or reset their PIN
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'at', 'unlockId'])
                    && validName(request.resource.data.name)
                    && request.resource.data.name.lower() == key
                    && adminProved(request.resource.data);
      allow delete: if false;
    }

    // Each player's PIN. Never readable.
    match /playerSecrets/{key} {
      allow create: if request.resource.data.keys().hasOnly(['pin'])
                    && validPin(request.resource.data.pin)
                    && getAfter(db('players/' + key)).data.at == request.time;
      allow create, update: if request.resource.data.keys().hasOnly(['pin', 'unlockId'])
                    && validPin(request.resource.data.pin)
                    && adminProved(request.resource.data);
      allow read, delete: if false;
    }

    // Player email (PIN recovery + opt-in news list; venue = where it was collected) and optional IFPA number.
    // A player can only save their own, signed with their PIN (playerUnlock in the same batch).
    // No web page can read it; only the organizer's Google account (admin.html, Sign in with Google).
    match /playerContacts/{key} {
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'news', 'venue', 'at', 'proof', 'ifpa'])
                    && ('email' in request.resource.data || 'ifpa' in request.resource.data)
                    && (!('email' in request.resource.data) || (request.resource.data.email is string
                        && request.resource.data.email.size() <= 100
                        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')))
                    && (!('news' in request.resource.data) || request.resource.data.news is bool)
                    && (!('ifpa' in request.resource.data) || (request.resource.data.ifpa is int
                        && request.resource.data.ifpa > 0 && request.resource.data.ifpa < 10000000))
                    && request.resource.data.venue is string && request.resource.data.venue.size() <= 40
                    && request.resource.data.at == request.time
                    && request.resource.data.proof is string
                    && playerProved(request.resource.data.proof, key);
      // The organizer's Google account (Firebase Auth uid), signed in on admin.html.
      allow read: if request.auth != null && request.auth.uid == 'yBphTXSIxYT27i1xod4KdBcdUK32';
      allow delete: if false;
    }

    // One doc per player save. Write-only: the PIN in it can't be read back.
    match /playerUnlock/{unlockId} {
      allow create: if request.resource.data.keys().hasOnly(['playerKey', 'pin', 'at'])
                    && request.resource.data.at == request.time
                    && request.resource.data.pin == get(db('playerSecrets/' + request.resource.data.playerKey)).data.pin;
      allow read, update, delete: if false;
    }

    // One doc per organizer change. Write-only: the PIN in it can't be read back.
    match /adminUnlock/{unlockId} {
      allow create: if request.resource.data.keys().hasOnly(['pin', 'at'])
                    && request.resource.data.at == request.time
                    && request.resource.data.pin == get(db('secrets/admin')).data.pin;
      allow read, update, delete: if false;
    }

    // Courses a location builds itself (admin > Build a course; The Manor first, 2026-11-26).
    // Anyone can read them (the scorecard needs them). A location can create/update only its own
    // (loc unchanged); the organizer can too. Never deleted from a page (an event may use it).
    function courseShape(d) {
      return d.keys().hasOnly(['loc', 'name', 'holes', 'mulligans', 'unlockId', 'updatedAt'])
        && d.loc is string && d.loc.matches('^[a-z0-9-]{1,30}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.holes is list && d.holes.size() >= 1 && d.holes.size() <= 60
        && d.mulligans is int && d.mulligans >= 0 && d.mulligans <= 2
        && d.updatedAt is int;
    }
    match /courses/{courseId} {
      allow read: if true;
      allow create: if courseId.matches('^c-[a-z0-9-]{1,40}$') && courseShape(request.resource.data)
                    && (locProved(request.resource.data.unlockId, request.resource.data.loc) || adminProved(request.resource.data));
      allow update: if courseShape(request.resource.data) && request.resource.data.loc == resource.data.loc
                    && (locProved(request.resource.data.unlockId, resource.data.loc) || adminProved(request.resource.data));
      allow delete: if false;
    }

    // One doc per location-admin change. Write-only: the PIN in it can't be read back.
    match /locUnlock/{unlockId} {
      allow create: if request.resource.data.keys().hasOnly(['loc', 'pin', 'at'])
                    && request.resource.data.loc is string && request.resource.data.loc.matches('^[a-z0-9-]{1,30}$')
                    && request.resource.data.at == request.time
                    && request.resource.data.pin == get(db('secrets/loc_' + request.resource.data.loc)).data.pin;
      allow read, update, delete: if false;
    }

    // Location PINs (secrets/loc_<id>): only the organizer can set them; nobody can read them.
    // secrets/admin is never writable from a page.
    match /secrets/{secretId} {
      allow create, update: if secretId.matches('^loc_[a-z0-9-]{1,30}$')
                    && request.resource.data.keys().hasOnly(['pin', 'unlockId'])
                    && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4,8}$')
                    && adminProved(request.resource.data);
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
